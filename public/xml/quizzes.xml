        <!-- STAGE 1 -->

        <stage id="dsa1">

            <name>Array Awakening</name>

            <question id="dsa1q1">
                <text>
                    What is the time complexity of accessing an element in an array using its index?
                </text>

                <options>
                    <option id="A">O(n)</option>
                    <option id="B">O(log n)</option>
                    <option id="C">O(1)</option>
                    <option id="D">O(n²)</option>
                </options>

                <answer>C</answer>
                <xp>100</xp>
            </question>

            <question id="dsa1q2">
                <text>
                    Which data structure follows the LIFO principle?
                </text>

                <options>
                    <option id="A">Queue</option>
                    <option id="B">Stack</option>
                    <option id="C">Graph</option>
                    <option id="D">Heap</option>
                </options>

                <answer>B</answer>
                <xp>100</xp>
            </question>

            <question id="dsa1q3">
                <text>
                    What is the worst-case time complexity of linear search?
                </text>

                <options>
                    <option id="A">O(1)</option>
                    <option id="B">O(log n)</option>
                    <option id="C">O(n)</option>
                    <option id="D">O(n log n)</option>
                </options>

                <answer>C</answer>
                <xp>100</xp>
            </question>

        </stage>


        <!-- STAGE 2 -->

        <stage id="dsa2">

            <name>Linked Network</name>

            <question id="dsa2q1">
